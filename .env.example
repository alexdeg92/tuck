# No .env is needed for make cloud on http://localhost:8081 (six containers,
# source builds, demo login). Optional shell/Make setting: CLOUD_LOCAL_PORT=8082.
# Copy to .env for production (never commit it). Any DOMAIN or ACME_EMAIL selector,
# even empty, requires BOTH to be valid. Values must be literal, no interpolation.
# Development-only .env files without either selector still select localhost cloud.

# --- make cloud ---------------------------------------------------------------------------------

# Public hostname whose DNS A/AAAA record points at this machine; ports 80 and 443 must be open.
DOMAIN=todo.example.com

# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Optional. Let's Encrypt staging while testing (untrusted certificates, generous rate limits):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Optional. Seed demo@example.com / demo1234 and show the demo shortcut on sign-in (default false).
# SEED_DEMO=true

# Optional. Host ports Traefik listens on (default 80 and 443).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- npm run dev ---------------------------------------------------------------------------------

# Port the API listens on.
PORT=3000

# HS256 signing secret for session tokens (at least 32 characters). Development placeholder only:
# production refuses to boot with it. The Docker stacks use the generated .env.secret instead.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me

# SQLite database file, relative to the API working directory.
DATABASE_FILE=./data/todo.db

# Optional. Use Postgres instead of the SQLite file (migrated on start).
# DATABASE_URL=postgres://todo:change-me@localhost:5432/todo

# development | test | production
NODE_ENV=development
