{
  "name": "todo-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta npm:dev:api npm:dev:web",
    "dev:api": "npm run dev -w @todo/api",
    "dev:web": "npm run dev -w @todo/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "vitest run --root scripts",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:pg": "node scripts/with-test-services.mjs npm run test:pg -w @todo/api",
    "e2e": "npm run e2e -w @todo/e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:debug": "node scripts/check-no-debug.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:arch && npm run test:scripts && npm run test:coverage && npm run build && npm run check:debug"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.7",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  },
  "description": "Tuck: a task list with a typed REST API and a React client"
}
